# Параметры окружения для docker compose (подставляются в compose.yaml).

# Внешние порты. Свободные по умолчанию: 80/8080 заняты ПР №5, 8090/8091 — ПР №7
HTTP_PORT=8000
TRAEFIK_DASHBOARD_PORT=8081
KAFKA_UI_PORT=8082

# Часовой пояс контейнеров (время в ответах и логах)
TZ=Europe/Moscow

# Отдельная БД у каждого сервиса: свой контейнер PostgreSQL, своя база, свой пользователь
SUPPLIERS_DB=suppliers_db
SUPPLIERS_DB_USER=suppliers
SUPPLIERS_DB_PASSWORD=suppliers_secret

ORDERS_DB=orders_db
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders_secret

DELIVERIES_DB=deliveries_db
DELIVERIES_DB_USER=deliveries
DELIVERIES_DB_PASSWORD=deliveries_secret

# Order Service -> Supplier Service: таймаут одной попытки, число попыток,
# сколько circuit breaker остаётся открытым
SUPPLIER_TIMEOUT=2s
SUPPLIER_RETRY_ATTEMPTS=3
SUPPLIER_CB_OPEN_STATE=15s

# Delivery Service: тарифы (как в ПР №5) и шаг имитации курьера
DELIVERY_BASE_COST=199
DELIVERY_FREE_THRESHOLD=1500
COURIER_STEP=4s
