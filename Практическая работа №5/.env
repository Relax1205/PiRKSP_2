# Параметры окружения для docker compose (подставляются в compose.yaml).

# Внешние порты Traefik
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Часовой пояс контейнеров (время в ответах сервисов)
TZ=Europe/Moscow

# База данных Order Service
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_secret

# Количество экземпляров Delivery Service за балансировщиком
DELIVERY_REPLICAS=3

# Тарифы доставки
DELIVERY_BASE_COST=199
DELIVERY_FREE_THRESHOLD=1500
DELIVERY_ESTIMATED_MINUTES=60
